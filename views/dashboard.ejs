<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ocean Intelligence</title>

    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

    <!-- LOADING SCREEN -->

    <div id="loadingScreen" class="loading-screen">

        <div class="loading-content">

            <div class="loader-ring"></div>

            <div class="loading-title">
                OCEAN DATA VISUALIZATION
            </div>

            <div class="loading-subtitle">
                INITIALIZING OCEAN SYSTEM
            </div>

            <div class="loading-text">
                LOADING MARINE DATA
            </div>

            <div class="loading-progress">
                <span></span>
            </div>

        </div>

    </div>


    <!-- BACKGROUND -->

    <div class="background-glow"></div>


    <!-- THREE JS GLOBE -->

    <canvas id="oceanCanvas"></canvas>


    <!-- DASHBOARD -->

    <div class="dashboard">


        <!-- =================================================
             TOP BAR
        ================================================== -->

        <header class="topbar">

            <div class="brand">

                <div class="brand-icon">
                    ◉
                </div>

                <div class="brand-text">

                    <strong>
                        OCEAN INTELLIGENCE
                    </strong>

                    <span>
                        VISUALIZATION SYSTEM
                    </span>

                </div>

            </div>


            <div class="top-center">
                INTERACTIVE MARINE DATA PLATFORM
            </div>


            <div class="user-area">

                <div class="live-status">

                    <span></span>

                    SYSTEM ONLINE

                </div>


                <div class="profile">

                    <div class="profile-avatar">

                        <%= (typeof userName !== "undefined" && userName)
                            ? userName.split(" ").map(n => n[0]).join("").toUpperCase()
                            : "U" %>

                    </div>


                    <div class="profile-info">

                        <strong>
                            <%= (typeof userName !== "undefined" && userName)
                                ? userName
                                : "USER" %>
                        </strong>

                        <small>
                            DATA ANALYSIS
                        </small>

                    </div>


                    <a
                        href="/logout"
                        class="logout-button"
                    >
                        LOGOUT
                    </a>

                </div>

            </div>

        </header>


        <!-- =================================================
             MAIN DASHBOARD
        ================================================== -->

        <main class="dashboard-main">


            <!-- =================================================
                 LEFT TOP - DEPTH CONTROL
            ================================================== -->

            <section class="left-panel">

                <div class="depth-section">

                    <div class="panel-label">
                        OCEAN EXPLORATION
                    </div>


                    <div class="depth-heading">

                        <span>
                            DEPTH CONTROL
                        </span>

                        <strong>

                            <span id="depthValue">
                                0
                            </span>m

                        </strong>

                    </div>


                    <input
                        type="range"
                        id="depthSlider"
                        min="0"
                        max="6000"
                        value="0"
                        step="1"
                    >


                    <div class="depth-range">

                        <span>
                            0m
                        </span>

                        <span>
                            6000m
                        </span>

                    </div>

                </div>


                <!-- DIVE BUTTON -->

                <button
                    id="diveButton"
                    class="dive-button"
                    type="button"
                >

                    <span class="dive-symbol">
                        ↓
                    </span>


                    <div class="dive-text">

                        <strong>
                            DIVE
                        </strong>

                        <small>
                            EXPLORE UNDERWATER DATA
                        </small>

                    </div>


                    <span class="dive-arrow">
                        →
                    </span>

                </button>

            </section>


            <!-- =================================================
                 CENTER TITLE
            ================================================== -->

            <section class="globe-title">

                <span>
                    LIVE MARINE ENVIRONMENT
                </span>

                <h1>
                    OCEAN INTELLIGENCE
                </h1>

                <p>
                    INTERACTIVE MARINE DATA VISUALIZATION
                </p>

            </section>


            <!-- =================================================
                 TOP RIGHT - LOCATION SELECTOR
            ================================================== -->

            <section class="coordinate-panel">

                <div class="coordinate-title">

                    <span class="coordinate-icon">
                        ⌖
                    </span>


                    <div>

                        <strong>
                            SELECT LOCATION
                        </strong>

                        <small>
                            ENTER COORDINATES TO EXPLORE OCEAN DATA
                        </small>

                    </div>

                </div>


                <div class="coordinate-fields">


                    <!-- LATITUDE -->

                    <div class="field">

                        <label for="latInput">
                            LATITUDE
                        </label>

                        <input
                            type="number"
                            id="latInput"
                            value="12"
                            min="-90"
                            max="90"
                            step="0.01"
                        >

                    </div>


                    <!-- LONGITUDE -->

                    <div class="field">

                        <label for="lonInput">
                            LONGITUDE
                        </label>

                        <input
                            type="number"
                            id="lonInput"
                            value="70"
                            min="-180"
                            max="180"
                            step="0.01"
                        >

                    </div>


                    <!-- LOCATE -->

                    <button
                        id="locateButton"
                        type="button"
                    >
                        LOCATE
                    </button>

                </div>


                <span class="coordinate-hint">

                    USE DECIMAL DEGREES •
                    LATITUDE -90 TO 90 •
                    LONGITUDE -180 TO 180

                </span>

            </section>


            <!-- =================================================
                 RIGHT SIDE - OCEAN DATA
            ================================================== -->

            <section class="location-card">


                <!-- LOCATION HEADER -->

                <div class="location-header">

                    <div>

                        <span>
                            OCEAN CONDITIONS
                        </span>

                        <h2 id="locationName">
                            SELECTED LOCATION
                        </h2>

                    </div>


                    <div class="live-badge">
                        LIVE
                    </div>

                </div>


                <!-- LATITUDE + LONGITUDE -->

                <div class="coordinates">


                    <div>

                        <small>
                            LATITUDE
                        </small>

                        <strong id="currentLat">
                            --
                        </strong>

                    </div>


                    <div>

                        <small>
                            LONGITUDE
                        </small>

                        <strong id="currentLon">
                            --
                        </strong>

                    </div>

                </div>


                <!-- OCEAN PARAMETERS -->

                <div class="ocean-data-grid">


                    <!-- TEMPERATURE -->

                    <div class="ocean-data">

                        <span>
                            TEMPERATURE
                        </span>

                        <strong>

                            <span id="temperature">
                                --
                            </span>

                            <small class="condition-unit">
                                °C
                            </small>

                        </strong>

                    </div>


                    <!-- SALINITY -->

                    <div class="ocean-data">

                        <span>
                            SALINITY
                        </span>

                        <strong>

                            <span id="salinity">
                                --
                            </span>

                            <small class="condition-unit">
                                PSU
                            </small>

                        </strong>

                    </div>


                    <!-- OCEAN CURRENT -->

                    <div class="ocean-data">

                        <span>
                            OCEAN CURRENT
                        </span>

                        <strong>

                            <span id="currentSpeed">
                                --
                            </span>

                            <small class="condition-unit">
                                m/s
                            </small>

                        </strong>

                    </div>


                    <!-- CURRENT DIRECTION -->

                    <div class="ocean-data">

                        <span>
                            CURRENT DIRECTION
                        </span>

                        <strong id="currentDirection">
                            --
                        </strong>

                    </div>

                </div>


                <!-- DATA CONFIDENCE -->

                <div class="confidence">

                    <span class="confidence-dot"></span>

                    <span>
                        DATA CONFIDENCE
                    </span>

                    <strong id="dataConfidence">
                        --
                    </strong>

                </div>

            </section>


            <!-- =================================================
                 DEPTH + OCEAN ZONE
            ================================================== -->

            <section class="right-stats">


                <!-- CURRENT DEPTH -->

                <div class="stat-card">

                    <span>
                        CURRENT DEPTH
                    </span>

                    <strong>

                        <span id="currentDepth">
                            0
                        </span>m

                    </strong>

                    <small>
                        SELECTED OCEAN DEPTH
                    </small>

                </div>


                <!-- OCEAN ZONE -->

                <div class="stat-card">

                    <span>
                        OCEAN ZONE
                    </span>

                    <strong id="waterType">
                        SURFACE
                    </strong>

                    <small>
                        OCEAN LAYER
                    </small>

                </div>

            </section>


            <!-- =================================================
                 BOTTOM BAR
            ================================================== -->

            <div class="bottom-bar">


                <div class="system-status">

                    <span></span>

                    <div>

                        <strong>
                            OCEAN EXPLORATION ACTIVE
                        </strong>

                        <small>
                            LIVE DATA CONNECTION
                        </small>

                    </div>

                </div>


                <div class="view-controls">

                    <button
                        id="resetButton"
                        type="button"
                    >
                        RESET
                    </button>

                    <button
                        id="zoomButton"
                        type="button"
                    >
                        ZOOM
                    </button>

                </div>

            </div>

        </main>


        <!-- =================================================
             DIVE OVERLAY
        ================================================== -->

        <div
            id="diveOverlay"
            class="dive-overlay"
        >

            <div class="dive-content">

                <div class="dive-icon">
                    ↓
                </div>

                <span>
                    UNDERWATER MODE
                </span>

                <h2>

                    <span id="diveDepth">
                        0
                    </span>m

                </h2>

                <p>
                    EXPLORING OCEAN DEPTH
                </p>

            </div>

        </div>

    </div>


    <!-- THREE.JS -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>


    <!-- YOUR EXISTING DASHBOARD JS -->

    <script src="/js/dashboard.js"></script>


    <!-- LOADING SCREEN -->

    <script>

        window.addEventListener("load", function () {

            const loadingScreen =
                document.getElementById("loadingScreen");

            if (!loadingScreen) return;

            setTimeout(function () {

                loadingScreen.classList.add("hidden");

                setTimeout(function () {

                    loadingScreen.style.display = "none";

                }, 900);

            }, 1000);

        });

    </script>

</body>

</html>