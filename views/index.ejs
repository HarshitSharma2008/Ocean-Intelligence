<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ocean Intelligence</title>

    <link rel="stylesheet" href="/css/index.css">
</head>

<body>

    <div id="loader">
        <div class="loader-ocean"></div>
        <div class="loader-text">ENTERING THE DEEP</div>
        <div class="loader-line">
            <span></span>
        </div>
    </div>

    <div id="cursor"></div>
    <div id="cursor-dot"></div>

    <div id="three-container"></div>

    <div class="water-overlay"></div>

    <header class="navbar">

        <div class="logo">
            OCEAN<span>INTELLIGENCE</span>
        </div>

        <nav class="nav-links">
            <a href="#home">Home</a>
            <a href="#features">Features</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="nav-buttons">

            <a href="/login" class="login-btn">
                Login
            </a>

            <a href="/signup" class="signup-btn">
                Sign Up
            </a>

        </div>

    </header>


    <main>

        <section id="home" class="hero">

            <div class="hero-vignette"></div>

            <div class="hero-content">

                <div class="hero-tag">
                    DISCOVER THE UNKNOWN
                </div>

                <h1>
                    EXPLORE THE
                    <span>DEEP OCEAN</span>
                </h1>

                <p class="hero-description">
                    Dive beneath the surface and discover a hidden
                    world of life, mysteries and intelligent ocean
                    insights.
                </p>

                <div class="hero-buttons">

                    <a href="/login" class="primary-btn">
                        <span>START EXPLORING</span>
                    </a>

                    <a href="#features" class="secondary-btn">
                        DISCOVER MORE
                    </a>

                </div>

            </div>

            <div class="depth-meter">

                <span>DEPTH</span>

                <strong id="depth-value">
                    000 M
                </strong>

                <div class="depth-line">
                    <span></span>
                </div>

            </div>

            <div class="scroll-indicator">

                <span>SCROLL TO DIVE</span>

                <div class="scroll-arrow">
                    ↓
                </div>

            </div>

        </section>


        <section id="features" class="features-section">

            <div class="section-heading">

                <div class="section-tag">
                    ENTER THE DEEP
                </div>

                <h2>
                    Explore Beyond
                    <span>The Surface</span>
                </h2>

                <p>
                    An immersive environment designed to transform
                    ocean exploration into an interactive experience.
                </p>

            </div>


            <div class="features-container">

                <article class="feature-card">

                    <div class="card-number">
                        01
                    </div>

                    <div class="feature-icon">
                        ◈
                    </div>

                    <h3>
                        Dive Into The Ocean
                    </h3>

                    <p>
                        Experience a visual journey through the
                        underwater world with immersive depth.
                    </p>

                    <div class="card-glow"></div>

                </article>


                <article class="feature-card">

                    <div class="card-number">
                        02
                    </div>

                    <div class="feature-icon">
                        ◉
                    </div>

                    <h3>
                        Discover Ocean Data
                    </h3>

                    <p>
                        Explore meaningful information and insights
                        hidden beneath the surface.
                    </p>

                    <div class="card-glow"></div>

                </article>


                <article class="feature-card">

                    <div class="card-number">
                        03
                    </div>

                    <div class="feature-icon">
                        ✓
                    </div>

                    <h3>
                        Trustworthy Results
                    </h3>

                    <p>
                        Understand the reliability and confidence
                        behind the information you explore.
                    </p>

                    <div class="card-glow"></div>

                </article>

            </div>

        </section>


        <section id="about" class="about-section">

            <div class="about-orb"></div>

            <div class="about-content">

                <div class="section-tag">
                    THE MISSION
                </div>

                <h2>
                    Understanding
                    <span>Our Oceans</span>
                </h2>

                <p>
                    Ocean Intelligence is designed to make complex
                    ocean-related information easier to understand
                    through interactive visualization and intelligent
                    insights.
                </p>

                <p>
                    Instead of simply looking at information,
                    users experience the ocean as an interactive
                    environment.
                </p>

                <a href="/login" class="primary-btn">
                    <span>EXPLORE THE PLATFORM</span>
                </a>

            </div>

        </section>


        <section id="contact" class="contact-section">

            <div class="contact-ring ring-one"></div>
            <div class="contact-ring ring-two"></div>
            <div class="contact-ring ring-three"></div>

            <div class="contact-content">

                <div class="section-tag">
                    FINAL DESCENT
                </div>

                <h2>
                    Ready To
                    <span>Explore?</span>
                </h2>

                <p>
                    Step beyond the surface and enter the world
                    beneath the waves.
                </p>

                <a href="/login" class="primary-btn">
                    <span>ENTER OCEAN INTELLIGENCE</span>
                </a>

            </div>

        </section>

    </main>


    <footer class="footer">

        <div class="footer-logo">
            OCEAN<span>INTELLIGENCE</span>
        </div>

        <p>
            Exploring the ocean. Understanding the unknown.
        </p>

        <small>
            © 2026 Ocean Intelligence
        </small>

    </footer>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <script src="/js/index.js"></script>

</body>

</html>