<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ocean Intelligence | Sign Up</title>

    <link rel="stylesheet" href="/css/signup.css">
</head>

<body>

    <div class="signup-page">

        <div class="underwater-glow"></div>

        <div class="sun-rays"></div>

        <div class="ocean-particles">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

        <div class="bubble-field">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
        </div>

        <div class="whale whale-one">
            <div class="whale-body"></div>
            <div class="whale-tail"></div>
        </div>

        <div class="whale whale-two">
            <div class="whale-body"></div>
            <div class="whale-tail"></div>
        </div>

        <div class="fish fish-one"></div>
        <div class="fish fish-two"></div>
        <div class="fish fish-three"></div>

        <div class="sea-floor">
            <div class="rock rock-one"></div>
            <div class="rock rock-two"></div>
            <div class="rock rock-three"></div>
        </div>

        <a href="/" class="back-home">
            ← Back to Ocean Intelligence
        </a>

        <div class="signup-card">

            <div class="card-light"></div>

            <div class="brand">
                <div class="brand-icon">◈</div>

                <span>
                    OCEAN<span>INTELLIGENCE</span>
                </span>
            </div>

            <div class="heading">

                <p>
                    BEGIN YOUR JOURNEY
                </p>

                <h1>
                    Create Your
                    <span>Account</span>
                </h1>

                <div class="heading-line"></div>

                <p class="subtitle">
                    Enter the ocean and discover what lies beneath.
                </p>

            </div>

            <form action="/signup" method="POST">

                <div class="input-group">

                    <label for="name">
                        Full Name
                    </label>

                    <div class="input-box">

                        <span class="input-icon">
                            ◉
                        </span>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your name"
                            required
                        >

                    </div>

                </div>

                <div class="input-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="input-box">

                        <span class="input-icon">
                            @
                        </span>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required
                        >

                    </div>

                </div>

                <div class="input-group">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-box">

                        <span class="input-icon">
                            ◆
                        </span>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Create a password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            id="passwordToggle"
                        >
                            SHOW
                        </button>

                    </div>

                </div>

                <div class="password-strength">

                    <div class="strength-bar">
                        <span></span>
                    </div>

                    <small id="strengthText">
                        Password strength
                    </small>

                </div>

                <button
                    type="submit"
                    class="signup-btn"
                >

                    <span class="btn-text">
                        CREATE ACCOUNT
                    </span>

                    <span class="btn-arrow">
                        →
                    </span>

                    <div class="button-shine"></div>

                </button>

            </form>

            <div class="login-text">

                Already have an account?

                <a href="/login">
                    Sign In
                </a>

            </div>

            <div class="secure-text">

                <span>
                    ◉
                </span>

                Your journey starts here

            </div>

        </div>

    </div>

    <script src="/js/signup.js"></script>

</body>

</html>